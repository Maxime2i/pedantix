# URL de l'API Pédantix (backend Flask). Défaut en dev : http://localhost:5000
# Sur macOS, le port 5000 est souvent pris par AirPlay : lancez le backend
# avec PORT=5001 et pointez VITE_API_URL vers http://localhost:5001
# En production (Vercel) : pointer vers le backend de production.
VITE_API_URL=http://localhost:5000
